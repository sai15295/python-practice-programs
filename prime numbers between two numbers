n = int(input("Enter starting number:  "))
N = int(input("Enter ending  number:  "))
print(f"The prime numbers between {n} and {N} are: ")
sum = 0
count = 0
for i in range(n,N+1):
	for j in range(2,i):
		if i%j == 0:
			break
	else:
		print(i)
		count+=1
		sum+=i
print("Count of these prime numbers: ",count)
print("Sum  of these prime numbers: ",sum)

