present = int(input("Enter present reading:  "))
previous = int(input("Enter previous reading:  "))
units_con = present - previous
print("units consumed: ",units_con)
if units_con<=100:
	unit_price = 2
	print("Electricity bill: ",units_con*unit_price)
elif units_con<=200:
	unit_price = 3
	print("Electricity bill: ",units_con*unit_price)
elif units_con>200:
	unit_price = 5
	print("Electricity bill: ",units_con*unit_price)
FC = int(input("Fixed charges:  "))
CC = int(input("Customer charges:  "))
ED = float(input("Electricity Duty:  "))
LG = float(input("Loss/Gain:  "))
print("Bill Amount = ",units_con*unit_price+FC + CC + ED + LG)

	